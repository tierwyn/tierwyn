#!/usr/bin/env node
import { spawnSync } from 'node:child_process';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const packageRoot = path.join(__dirname, '..');

export function resolveInstallSh() {
  const override = process.env.TIERWYN_CLI_INSTALL_SH;
  if (override) return override;

  const bundled = path.join(packageRoot, 'install.sh');
  if (fs.existsSync(bundled)) return bundled;

  const devFallback = path.join(packageRoot, '../../../scripts/install.sh');
  if (fs.existsSync(devFallback)) return devFallback;

  return bundled;
}

export function installDetected(home = os.homedir()) {
  if (process.env.TIERWYN_DIR) return true;
  return fs.existsSync(path.join(home, 'tierwyn'));
}

export function argvForInstall(userArgv, home = os.homedir()) {
  if (userArgv.length === 0 && !installDetected(home)) {
    return ['setup'];
  }
  return userArgv;
}

export function runTierwyn(userArgv = process.argv.slice(2)) {
  if (process.platform === 'win32') {
    console.error('tierwyn requires Linux/macOS bash');
    return 1;
  }

  const installSh = resolveInstallSh();
  if (!fs.existsSync(installSh)) {
    console.error(`tierwyn: install.sh not found at ${installSh}`);
    return 1;
  }

  const args = argvForInstall(userArgv, os.homedir());
  const result = spawnSync('bash', [installSh, ...args], { stdio: 'inherit' });

  if (result.error) {
    console.error(`tierwyn: failed to run bash: ${result.error.message}`);
    return 1;
  }
  if (result.signal) {
    return 128 + (result.signal === 'SIGTERM' ? 15 : 1);
  }
  return result.status ?? 1;
}

// npm runs bins through a symlink (<prefix>/bin/tierwyn, npx cache): compare real paths.
const realArgv1 = () => { try { return fs.realpathSync(process.argv[1]); } catch { return path.resolve(process.argv[1]); } };
const isMain =
  process.argv[1] &&
  pathToFileURL(realArgv1()).href === pathToFileURL(fs.realpathSync(fileURLToPath(import.meta.url))).href;
if (isMain) {
  process.exit(runTierwyn());
}