.worktrees/
# Ephemeral agent workspace (spawn handoffs, schedule scratch). Not source.
.tierwyn/
node_modules/
/node_modules
dist/
*.db
data/
data.bak*/
.tmp/
.env
.env.local
.kilo/
.firecrawl
