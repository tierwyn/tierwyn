# Tierwyn — environment configuration
# Copy to .env and fill in values.
#
# Variable names use the TIERWYN_* prefix.

# Server binding (never change HOST to 0.0.0.0 - security requirement)
HOST=127.0.0.1
PORT=8787

# Vite Host-header allowlist for `vite` / `vite preview` (DNS-rebinding protection).
# Unset/empty → Vite default (localhost + IPs only). `true` or `all` → allow any Host.
# Otherwise a comma-separated hostname list. The prod-web unit sets `true` so a
# reverse-proxied public domain is accepted; narrow it to your hostname in the unit.
# TIERWYN_ALLOWED_HOSTS=true
# TIERWYN_ALLOWED_HOSTS=tierwyn.example.com

# SQLite database path (created on first boot). Dev default below. Prod uses
# its own env file (/etc/tierwyn/prod.env) with TIERWYN_DB=./data/prod.db.
TIERWYN_DB=./data/tierwyn.db

# Allowed project roots for local clone, folder browsing, and auto-creation.
# Colon-separated list of absolute paths (:). Unset defaults to [user home directory].
# Set to empty ("") to disable folder browsing and local clone entirely.
# TIERWYN_PROJECT_ROOTS=/home/user/Projects:/var/data

# Dedicated hub user install (written by `tierwyn setup` → hub mode into hub.env).
# Sandbox defaults on until saved in Settings, and projects at/above this checkout are
# refused. Leave unset on a dev checkout where agents must edit the repo.
# TIERWYN_DEDICATED_HUB=1

# Maximum depth of spawn chains. depth(root)=0; a conversation at depth >=
# this value may not spawn further children. Default 5 (root → ... → depth-5
# child). Lower it to narrow the delegation envelope; raise it cautiously —
# each level multiplies token spend and widens the prompt-injection surface.
TIERWYN_MAX_SPAWN_DEPTH=5

# Agent self-timers: may an agent schedule a timed wake-up into its OWN
# conversation (POST /conversations/:id/timers/agent)?
#   level0 (default) — top-level conversations only; spawned children get 403
#   all              — any conversation (children's self-wakes do NOT notify the parent)
#   off              — endpoint disabled (403)
# TIERWYN_AGENT_SELF_TIMERS=level0

# ---------------------------------------------------------------------------
# Plugins (phase 2 — vault + env fallback)
# ---------------------------------------------------------------------------
# Per-instance ESM plugins live in a gitignored directory (empty on clone).
# See docs/architecture/plugins.md. All vars below are optional.
#
# installed plugins (gitignored, empty on clone)
# TIERWYN_PLUGINS_DIR=./plugins
# TIERWYN_PLUGINS=off
# TIERWYN_CHILD_ENV_DENY=SOME_SECRET,ANOTHER_SECRET
# TIERWYN_PLUGIN_VAULT_KEY=
#
# Hub git (checkpoints, git panel, worktree add) runs with hooks disabled
# (`core.hooksPath=/dev/null`) so a sandboxed agent cannot plant an
# executable hook that the unsandboxed hub would later fire. Set to 1 to
# re-enable hooks on operator-initiated commit/push/pull/fetch only.
# Do not enable this while sandboxed agents work in the same repo.
# TIERWYN_GIT_RUN_HOOKS=1
#
# Optional, ≥32 bytes, **takes precedence over SESSION_SECRET** for
# plugin-credential encryption (key_id='env:v1'). Use it when you want to
# rotate the login secret without re-entering every plugin credential.
# Changing or removing it makes existing rows report
# "encrypted with a different key — re-enter".
#
# Dedicated plugin keys (e.g. ZAI_API_KEY) are captured at boot and deleted
# from process.env so agent children do not inherit them. UI-set vault
# values need no restart. Do NOT reuse OPENAI_API_KEY as the plugin credential.

# ---------------------------------------------------------------------------
# MCP Servers (Registry Fallback Secrets)
# ---------------------------------------------------------------------------
# MCP server secret environment variables and headers are typically managed
# via the encrypted vault in Settings → MCP Servers. For headless or automated
# setups, environment variables prefixed with `TIERWYN_MCP_` serve as boot-time
# fallbacks when vault entries are empty.
#
# Rules:
# - All `TIERWYN_MCP_*` variables are captured into memory at server boot and
#   deleted from `process.env`. Child agent processes never inherit them.
# - Minimum length is 8 characters. Values shorter than 8 characters fail closed
#   (treated as missing) to prevent leaking or skipping transcript redaction.
# - Secret placeholders injected into child configs use `TIERWYN_MCPV_*` (with a 'V');
#   fallback variable names must use `TIERWYN_MCP_*` and must not collide with placeholders.
#
# Examples:
# TIERWYN_MCP_GITHUB_TOKEN=ghp_exampleToken1234567890
# TIERWYN_MCP_DATABASE_URL=postgres://user:secret123@127.0.0.1:5432/db

# ---------------------------------------------------------------------------
# Artificial Analysis (optional — Settings → Templates can set the vault key)
# ---------------------------------------------------------------------------
# Boot-captured and deleted from process.env; children never inherit it.
# TIERWYN_AA_API_KEY=

# ---------------------------------------------------------------------------
# Authentication (Phase 4)
# ---------------------------------------------------------------------------

# argon2 hash of the single operator password.
# Generated with (run from the repo root):
#
#   node -e "require('argon2').hash(process.argv[1]).then(h=>console.log(h))" 'your-operator-password'
#
# The output looks like: $argon2id$v=19$m=65536,t=3,p=4$<salt>$<hash>
# Paste the full string here. The plaintext password is never stored or logged.
#
OPERATOR_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$REPLACE_WITH_YOUR_GENERATED_HASH

# Random secret used to sign (HMAC-SHA256) the session cookie.
# Must be at least 32 bytes of entropy. Generate a fresh value with either:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   openssl rand -base64 32
#
# Example output shape (do NOT use this exact value):
#   Hg0xQgbOaUBwQCyfRxUuyzEW9-AgJREuB5QtgdH7f2Y
#
# MISSING → the server fails fast at boot (unless AUTH_DISABLED=true).
#
SESSION_SECRET=REPLACE_WITH_YOUR_RANDOM_SECRET

# Allow the session cookie to be sent over plain HTTP (useful for localhost-only
# dev when you are not running behind a TLS-terminating proxy).
# Defaults to true (secure flag ON). Only set false for local HTTP dev.
# Must be true (or omitted) whenever the app is reachable over the network.
#
# COOKIE_SECURE=false

# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# WARNING: AUTH_DISABLED MUST BE OFF (unset or false) ONCE THE APP IS
# REACHABLE ON THE LAN OR ANY NETWORK.  Leaving it set to true with a
# LAN-facing proxy bypasses ALL authentication — anyone on the network can
# access Claude Code without a password.
#
# Only use AUTH_DISABLED=true for local development on a machine that is NOT
# accessible from any other device. The server refuses to boot with
# AUTH_DISABLED=true on a non-loopback HOST unless
# TIERWYN_ALLOW_AUTH_DISABLED_NONLOCAL=1 is set.
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
#
# AUTH_DISABLED=true

# Controls Express's "trust proxy" setting (app.set('trust proxy', ...)).
# This tells Express which upstream addresses to trust for X-Forwarded-For
# and for marking req.secure = true (needed so the Secure cookie flag is
# recognised and so req.ip reflects the real client IP for rate-limiting).
#
# Default: 'loopback' — trusts 127.0.0.1 / ::1 (correct when the proxy and
# Node run on the same machine, which is the standard setup).
#
# Set to '1' (trust one hop), or a specific IP/CIDR, if your proxy is remote.
# See: https://expressjs.com/en/guide/behind-proxies.html
#
# TRUST_PROXY=loopback

# ---------------------------------------------------------------------------
# PATH (production / systemd only)
# ---------------------------------------------------------------------------
#
# When tierwyn-prod.service spawns agent CLIs (claude, opencode,
# openclaw, copilot, pi, ...), it searches $PATH. The systemd user unit does NOT inherit your
# interactive shell PATH — it gets a minimal default that omits common
# install locations like ~/.npm-global/bin (where `npm i -g` puts CLIs).
#
# Symptom of a missing PATH: `spawn <agent> ENOENT` when launching a chat,
# even though `which <agent>` finds the binary in your terminal.
#
# Dev (.env, npm run dev): inherits your shell PATH, usually works as-is.
# Prod (/etc/tierwyn/prod.env): set PATH explicitly. Include every directory
# that holds an agent CLI. A safe default covering the common install
# locations on Debian/Ubuntu:
#
# PATH=/home/YOUR-USER/.local/bin:/home/YOUR-USER/.bun/bin:/home/YOUR-USER/.npm-global/bin:/home/YOUR-USER/.opencode/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
#
# Replace YOUR-USER with the unix user that owns the systemd unit. After
# editing, restart the unit:  systemctl --user restart tierwyn-prod.service
#
# Verify the live value:
#   tr '\0' '\n' < /proc/$(systemctl --user show -p MainPID -v tierwyn-prod.service | cut -d= -f2)/environ | grep ^PATH=

# ---------------------------------------------------------------------------
# Voice / Speech-to-Text (whisper.cpp)
# ---------------------------------------------------------------------------
#
# Tierwyn's mic button can drive a local whisper.cpp STT pipeline instead of
# the browser Web Speech API (see Settings → Voice → "Voice dictation
# engine"). The default is 'whisper' on fresh clients; toggle to 'browser'
# for the cloud-dependent Web Speech path.
#
# The server looks for the binary in this order:
#   1. $WHISPER_BIN_PATH (explicit override — useful for systemd units)
#   2. ~/.local/share/mewisper/bin/whisper-cli   (shared whisper data directory)
#   3. $PATH scan for `whisper-cli` or `whisper-cpp`
#
# Models (ggml-base.bin, ggml-small.bin, ggml-medium.bin) are stored under
# ~/.local/share/mewisper/models/ (shared whisper data directory). Missing models
# are downloadable from the Settings UI (Hugging Face, ~150 MB / 500 MB /
# 1.5 GB respectively).
#
# If `which whisper-cli` works from your terminal but Tierwyn reports the
# binary as missing, the systemd unit's PATH doesn't include its directory —
# set WHISPER_BIN_PATH explicitly, or extend the PATH line above.
#
# WHISPER_BIN_PATH=/home/YOUR-USER/.local/share/mewisper/bin/whisper-cli
# ---------------------------------------------------------------------------
# TTS sidecars (Piper / Kokoro) — no env vars required
# ---------------------------------------------------------------------------
# Read-aloud providers are configured in Settings → Voice (stored in the DB
# under the `voice` settings key), not via environment variables.
#
# Default piperUrl  http://127.0.0.1:5000  → tierwyn-piper.service
# Default kokoroUrl http://127.0.0.1:8880  → tierwyn-kokoro.service (native venv)
# Tierwyn TCP-probes both (GET /tts/config → piperUp / kokoroUp). It does NOT start them.
#
# Piper models: separate ONNX files under ~/piper-voices/ (UI download or manual).
# Kokoro: `tierwyn sidecars` builds ~/kokoro-venv (cpu / cuda / rocm PyTorch, auto-detected,
#   operator picks). Weights + voices download to ~/.cache/huggingface on first start.
#   Device lives in ~/.config/tierwyn/kokoro.env. Port open = model loaded and warmed.
#
# Operator install + systemd autostart:
#   docs/deploy/operator-sidecars.md
#   docs/deploy/systemd/tierwyn-piper.service
#   docs/deploy/piper/server.py  → copy to ~/tierwyn-piper/server.py
#   docs/deploy/systemd/tierwyn-kokoro.service
#
# Symptom when a unit is missing: Settings show that provider but playback
# falls back to browser speechSynthesis; piperUp / kokoroUp stays false.
# Kokoro "not working" is almost always unit not installed/started, not a missing model file.

# ---------------------------------------------------------------------------
# Grok Bot desktop (CDP sidecar; Tierwyn may start the unit on demand)
# ---------------------------------------------------------------------------
TIERWYN_GROKBOT_AUTOSTART=0
# dev: never auto-launch the desktop app. Omit in /etc/tierwyn/prod.env so prod can auto-start.
# TIERWYN_GROKBOT_CDP_PORT=9333
# TIERWYN_GROKBOT_IDLE_MS=8000   # default 8000
# Poll interval for unsolicited Bot messages when no Tierwyn session is open.
# TIERWYN_GROKBOT_WATCH_MS=25000
# TIERWYN_GROKBOT_REPLY_LEASE_MS=3600000
# Kill switch (unset / any value other than 0 = on):
# TIERWYN_GROKBOT_WATCH=0
# TIERWYN_GROKBOT_BIN=          # absolute path override (default /opt/Grok Bot/grok-bot)
# TIERWYN_GROKBOT_UNIT=tierwyn-grokbot.service
#
# Sidecar unit template: docs/deploy/systemd/tierwyn-grokbot.service
# Runbook: docs/deploy/operator-sidecars.md
